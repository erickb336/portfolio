{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erick-portfolio",
  "account_id": "13502e5876b6e5a3e06c767683e76f05",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/strava/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "erick-portfolio",
      "database_id": "6711ca39-fe00-4af7-8450-2dfca133423f",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "routes": [
    {
      "pattern": "erickbenitez.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "SPOTIFY_PROFILE_URL": "https://open.spotify.com/user/31l72ggdl353mhlixkugi4vxka2e"
  }
}
